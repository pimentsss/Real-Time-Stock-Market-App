NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Gemini (used by Inngest step.ai for welcome intros + news summaries)
GEMINI_API_KEY=

# Gmail account + app password for Nodemailer
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Finnhub (https://finnhub.io)
FINNHUB_API_KEY=

# Inngest: INNGEST_DEV=1 locally (run `npx inngest-cli@latest dev`); keys from the Inngest dashboard in production
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
